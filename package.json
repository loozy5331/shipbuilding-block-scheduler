{
  "name": "shipbuilding-block-scheduler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": ".venv/bin/python -m uvicorn --factory backend.app.main:create_app --host 0.0.0.0 --port ${PORT:-8787}",
    "test": "vitest run",
    "e2e": "playwright test",
    "setup:py": "uv venv .venv --python 3.12 && uv pip install --python .venv -r backend/requirements-dev.txt",
    "test:py": ".venv/bin/python -m pytest backend -q -p no:warnings"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
